# Sweet Scoop Backend — Environment Variables (Twelve-Factor #3)
# Copy to .env and adjust for local development.

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (shared connection host; each service uses its own DB)
PG_HOST=localhost
PG_PORT=5432
PG_USER=sweetscoop
PG_PASSWORD=sweetscoop

# MongoDB (Reviews service)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sweetscoop_reviews

# JWT
JWT_SECRET=sweetscoop-dev-secret-change-me
JWT_EXPIRES=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=100

# Service URLs (for placeOrder saga)
CATALOGUE_URL=http://localhost:3001
CUSTOMER_URL=http://localhost:3002
PAYMENT_URL=http://localhost:3004
DELIVERY_URL=http://localhost:3005

# Delivery SOAP partner
DELIVERY_PARTNER_URL=http://localhost:3005/soap/delivery
